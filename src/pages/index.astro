---
import PidSimulator from '../components/PidSimulator.jsx';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>Simulador PID - Misión Antivirus</title>
		<!-- Cargamos Tailwind v4 por CDN para blindarlo contra errores de compilación local -->
		<script src="https://unpkg.com/@tailwindcss/browser@4"></script>
	</head>
	<body class="bg-slate-950 text-slate-100 min-h-screen font-mono selection:bg-emerald-500 selection:text-black p-4 md:p-8">
		
		<main class="max-w-5xl mx-auto">
			<header class="mb-10 text-center">
				<div class="inline-block bg-slate-900 px-4 py-1 rounded-full text-emerald-400 text-xs mb-4 border border-emerald-500/30 shadow-[0_0_15px_rgba(16,185,129,0.2)]">
					[ NÚCLEO PID :: EN LÍNEA ]
				</div>
				<h1 class="text-3xl md:text-5xl font-bold mb-3 text-white tracking-wider">
					Simulador de Control de CPU
				</h1>
				<p class="text-emerald-400/70 text-sm md:text-base">
					&gt; Aplicación de la Transformada de Laplace para optimización de procesos_
				</p>
			</header>

			<!-- Componente interactivo -->
			<PidSimulator client:load />
		</main>

	</body>
</html>