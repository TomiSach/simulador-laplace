---
import PidSimulator from '../components/PidSimulator.jsx';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>Simulador PID - Misión Antivirus</title>
	</head>
	<body class="bg-slate-900 text-slate-100 min-h-screen font-sans selection:bg-emerald-500 selection:text-white">
		<main class="max-w-5xl mx-auto px-4 py-8">
			<header class="mb-8 text-center">
				<div class="inline-block bg-slate-800 px-4 py-1 rounded-full text-emerald-400 text-sm font-mono mb-4 border border-slate-700">
					[ ESTADO: EN LÍNEA ]
				</div>
				<h1 class="text-3xl md:text-4xl font-bold mb-2">Simulador de Control de CPU</h1>
				<p class="text-slate-400">Aplicación de la Transformada de Laplace para optimizar el escaneo del antivirus</p>
			</header>
			<PidSimulator client:load />
		</main>
	</body>
</html>